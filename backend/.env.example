CODERISK_ENVIRONMENT=development
CODERISK_DATABASE_URL=sqlite+pysqlite:///./coderisk.db
CODERISK_DATABASE_ECHO=false
CODERISK_DATABASE_AUTO_CREATE=false
CODERISK_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Required in production. Use a unique random value with at least 32 characters.
CODERISK_JWT_SECRET_KEY=replace-with-a-long-random-development-secret
